@model BibliotecaMVC_BD.Models.Libro

@{
    ViewData["Title"] = "Eliminar libro";
}

<h1>Eliminar libro</h1>

<div class="alert alert-warning">
    ¿Estás seguro de que deseas eliminar este libro?
</div>

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Codigo</dd>

    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>

    <dt class="col-sm-3">Autor</dt>
    <dd class="col-sm-9">@Model.Autor</dd>

    <dt class="col-sm-3">Fecha de publicación</dt>
    <dd class="col-sm-9">
        @Model.FechaPublicacion?.ToString("dd/MM/yyyy")
    </dd>
</dl>

<form asp-action="ConfirmarEliminacion"
      asp-route-id="@Model.IdLibro"
      method="post">

    <button type="submit" class="btn btn-danger">
        Sí, eliminar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>